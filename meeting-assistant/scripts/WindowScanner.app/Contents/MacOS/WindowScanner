#!/bin/bash
# WindowScanner Login Item - runs osascript to scan windows
# Outputs to a temp file that the detector reads
SCAN_SCRIPT="/Users/liaoyuxing/.openclaw/workspace/meeting-assistant/meeting-assistant/scripts/scan_windows.sh"
OUTPUT_FILE="/Users/liaoyuxing/.config/meeting-assistant/.window_scan.json"

while true; do
  result=$($SCAN_SCRIPT 2>/dev/null)
  if [ $? -eq 0 ] && [ -n "$result" ]; then
    echo "$result" > "$OUTPUT_FILE"
  fi
  sleep 5
done
