#!/usr/bin/env bash
#
# yulu — single-entry CLI for the Yulu meeting recorder.
#
# This script is what gets symlinked to ~/.local/bin/yulu by setup.sh.
# It dispatches to the underlying scripts in the repo so the user has
# one stable command surface even if the repo path changes.
#
# Subcommands:
#   yulu setup                Run the interactive installer (fresh install)
#   yulu update [--latest|--version vX.Y.Z|--dev]
#                             Update via release installer (default: latest stable)
#   yulu uninstall            Remove launchd, Yulu.app, agent skills, ~/.config/yulu
#   yulu start                Load all yulu LaunchAgents
#   yulu stop                 Unload all yulu LaunchAgents
#   yulu restart              stop + start
#   yulu version              Show Yulu version + git metadata
#   yulu status               Show service + daemon health
#   yulu doctor               Check config, daemon, model, queue, and calendar health
#   yulu logs [name]          Tail logs (default: audio_daemon)
#   yulu record start "title" Manual recording start
#   yulu record stop          Manual recording stop
#   yulu dictate ...          Experimental low-latency voice input
#   yulu repair-permissions   Reset/open Screen & System Audio Recording permission helper
#   yulu transcription ...    Switch transcription engine and post-recording mode
#   yulu where                Print key paths (repo / config / recordings / launchagents)

set -e

# Resolve the repo root from this script's actual location (follows symlinks).
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"

CONFIG_DIR="$HOME/.config/yulu"
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

ok()   { printf "${GREEN}✓${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}⚠${NC} %s\n" "$1"; }
err()  { printf "${RED}✗${NC} %s\n" "$1"; }
info() { printf "${BLUE}ℹ${NC} %s\n" "$1"; }

usage() {
    cat <<EOF
yulu — meeting recorder CLI

Usage: yulu <command> [args]

Commands:
  setup            Run the interactive installer (fresh install)
  update [--latest|--version vX.Y.Z|--dev]
                    Update from release assets (default: latest stable);
                    --version installs one specific release, --dev uses main
  uninstall        Remove Yulu from this machine
  start            Load all Yulu LaunchAgents
  stop             Unload all Yulu LaunchAgents
  restart          stop + start
  version          Show Yulu version + git metadata
  status           Service + daemon health snapshot
  doctor           Config + daemon + transcription + queue health check
  logs [daemon]    Tail logs. Daemon = audio_daemon (default), scheduler, detector, calendar, agentqueue, realtime_transcribe, ui
  record start "title"   Manually start a recording
  record stop            Manually stop the current recording
  dictate start|stop|once|toggle|ask
                    Experimental low-latency voice input. Mic-only recording,
                    STT dictation job, prompt/vocab context, clipboard, optional paste
                    Use --translate-to "English" for prompt-based quick translation
                    Use ask to send a voice question into Agent Console chat
  status-agent dictate
                    Toggle dictation through the running menu-bar agent IPC
  status-agent open-agent-console
                    Open Agent Console Ask/chat surface through the menu-bar agent IPC
  status-agent voice-chat
                    Record a voice question and send it into Agent Console chat
  status-agent hotkeys
                    Print configured global shortcuts for dictation, translation, and voice chat
  repair-permissions     Open/reset Screen & System Audio Recording permission helper
  transcription status   Show transcription engine + post-recording mode
  transcription mode fast|full
                    fast = realtime transcript -> polish -> summary
                    full = final full-audio transcription -> polish -> summary
  transcription engine mlx [model]
                    Use mlx-whisper, e.g. mlx-community/whisper-large-v3-mlx
  transcription engine whisper [model-path]
                    Use whisper.cpp GGML model
  transcription engine hermes [agent-dir]
                    Use Hermes' configured STT provider
  search "term" [--since 7d --type meeting --in summary --json --open]
                    Search across meetings and summaries
  provision <step>|--all|--list
                    Run a named install step (deps|audio|models|capabilities|daemons|ui),
                    --all to resume-walk all six (skips already-done steps;
                    verifies --asset first when given), or --list to show them
  skill install [--agent <name>]
                    Install/refresh the Yulu agent skill (decoupled from install,
                    idempotent), e.g. --agent claude-code --agent codex
  mcp status|install|remove|rotate-token|test
                    Manage Yulu HTTP MCP registration in detected local agents
  migrate [--dry-run]
                    Migrate an existing v0.5.x ~/.yulu install (detect->plan->apply
                    ->verify), transactional + no data loss; --dry-run prints the
                    planned corrections without applying anything
  migrate unify-voicemails [--apply]
                    Merge legacy voicemail recordings into the meetings store
                    (voicemail_* -> Memo_*); dry-run by default, pass --apply to move
  rollback          Restore the prior state from the most-recent migration backup
  where            Print key paths
  help             Show this help

Project: https://github.com/Nowhitestar/Yulu
EOF
}

# ─── Subcommands ──────────────────────────────────────────────────

cmd_setup() {
    bash "$SCRIPT_DIR/setup.sh" "$@"
}

cmd_update() {
    if [[ ! -f "$SCRIPT_DIR/release_installer.py" ]]; then
        err "release_installer.py not found at $SCRIPT_DIR — your install may be partial."
        exit 1
    fi
    python3 "$SCRIPT_DIR/release_installer.py" update \
        --install-dir "$REPO_DIR" \
        "$@"
}

cmd_uninstall() {
    if [[ -x "$SCRIPT_DIR/uninstall.sh" ]]; then
        bash "$SCRIPT_DIR/uninstall.sh" "$@"
    else
        err "uninstall.sh not found at $SCRIPT_DIR — your install may be partial."
        exit 1
    fi
}

# Iterate over all yulu LaunchAgent plists.
each_plist() {
    local cb="$1"
    local found=0
    for plist in "$LAUNCH_AGENTS_DIR"/com.yulu.*.plist; do
        [[ -f "$plist" ]] || continue
        found=1
        "$cb" "$plist"
    done
    if [[ $found -eq 0 ]]; then
        warn "No yulu LaunchAgents installed at $LAUNCH_AGENTS_DIR/com.yulu.*.plist"
        warn "Run: yulu setup"
        return 1
    fi
}

_load_one()   { launchctl load   "$1" 2>/dev/null && ok "loaded $(basename "$1")"   || warn "could not load $(basename "$1")"; }
_unload_one() { launchctl unload "$1" 2>/dev/null && ok "unloaded $(basename "$1")" || warn "could not unload $(basename "$1")"; }

cmd_start() {
    info "Loading Yulu LaunchAgents"
    each_plist _load_one
}

cmd_stop() {
    info "Unloading Yulu LaunchAgents"
    each_plist _unload_one
}

cmd_restart() {
    cmd_stop || true
    sleep 1
    cmd_start
}

cmd_status() {
    info "LaunchAgents:"
    if launchctl list | grep com.yulu; then
        :
    else
        warn "No com.yulu.* services running"
    fi
    echo
    info "audio_daemon socket:"
    if [[ -S "$CONFIG_DIR/audio_daemon.sock" ]]; then
        local resp
        resp=$(echo '{"action":"status"}' | nc -w 2 -U "$CONFIG_DIR/audio_daemon.sock" 2>/dev/null || true)
        if [[ -n "$resp" ]]; then
            echo "$resp" | python3 -m json.tool 2>/dev/null || echo "$resp"
        else
            warn "socket exists but no response"
        fi
    else
        warn "socket not found at $CONFIG_DIR/audio_daemon.sock"
    fi
    echo
    info "Recent recordings:"
    local rec_dir
    rec_dir=$(python3 -c "
import json
from pathlib import Path
try:
    cfg = json.loads(Path.home().joinpath('.config/yulu/config.json').read_text())
    print(cfg.get('audio', {}).get('output_dir', ''))
except Exception:
    pass
" 2>/dev/null)
    rec_dir="${rec_dir/#\~/$HOME}"
    if [[ -n "$rec_dir" && -d "$rec_dir" ]]; then
        echo "  $rec_dir"
        ls -lt "$rec_dir"/*.wav 2>/dev/null | head -5 | awk '{print "    "$NF" ("$5" bytes)"}'
    else
        warn "recording directory not configured or missing"
    fi
    echo
    info "Web UI:"
    local ui_resp
    ui_resp=$(curl -s --max-time 2 "http://127.0.0.1:7777/healthz" 2>/dev/null || true)
    if [[ -n "$ui_resp" ]] && echo "$ui_resp" | grep -q '"status":"ok"'; then
        ok "http://127.0.0.1:7777/  ($ui_resp)"
    else
        warn "yulu_ui not reachable at 127.0.0.1:7777 (try: yulu start)"
    fi
}

cmd_version() {
    python3 "$SCRIPT_DIR/version.py" "$@"
}

cmd_logs() {
    local name="${1:-audio_daemon}"
    case "$name" in
        agentqueue|agent_queue|agent-queue)
            name="agent_queue_worker"
            ;;
    esac
    local log_path="$CONFIG_DIR/${name}.log"
    if [[ ! -f "$log_path" ]]; then
        # Try alternative paths used by some daemons.
        local alt="$HOME/Library/Logs/yulu/${name}.log"
        if [[ -f "$alt" ]]; then
            log_path="$alt"
        else
            err "No log file at $log_path or $alt"
            echo "Available logs:"
            ls "$CONFIG_DIR"/*.log 2>/dev/null
            ls "$HOME/Library/Logs/yulu"/*.log 2>/dev/null
            exit 1
        fi
    fi
    info "tail -f $log_path  (Ctrl-C to stop)"
    tail -f "$log_path"
}

cmd_doctor() {
    python3 "$SCRIPT_DIR/doctor.py" "$@"
}

cmd_record() {
    local action="${1:-}"
    case "$action" in
        start)
            local title="${2:-}"
            if [[ -z "$title" ]]; then
                err "Usage: yulu record start \"<meeting title>\""
                exit 1
            fi
            python3 "$SCRIPT_DIR/meeting_daemon.py" start "$title"
            ;;
        stop)
            python3 "$SCRIPT_DIR/meeting_daemon.py" stop
            ;;
        status)
            python3 "$SCRIPT_DIR/record_audio.py" status
            ;;
        *)
            err "Usage: yulu record {start|stop|status}"
            exit 1
            ;;
    esac
}

cmd_repair_permissions() {
    python3 "$SCRIPT_DIR/repair_permissions.py" "$@"
}

cmd_transcription() {
    python3 "$SCRIPT_DIR/configure.py" transcription "$@"
}

cmd_where() {
    echo "Repo (code):       $REPO_DIR"
    echo "Config:            $CONFIG_DIR"
    echo "LaunchAgents:      $LAUNCH_AGENTS_DIR/com.yulu.*.plist"
    echo "Whisper models:    $CONFIG_DIR/models/"
    local rec_dir
    rec_dir=$(python3 -c "
import json
from pathlib import Path
try:
    cfg = json.loads(Path.home().joinpath('.config/yulu/config.json').read_text())
    print(cfg.get('audio', {}).get('output_dir', '<unset>'))
except Exception:
    print('<config not readable>')
" 2>/dev/null)
    echo "Recordings:        $rec_dir"
    echo "Yulu.app:          $REPO_DIR/yulu/scripts/Yulu.app"
}

# ─── Dispatcher ───────────────────────────────────────────────────

case "${1:-help}" in
    setup)     shift; cmd_setup "$@" ;;
    update)    shift; cmd_update "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    start)     shift; cmd_start "$@" ;;
    stop)      shift; cmd_stop "$@" ;;
    restart)   shift; cmd_restart "$@" ;;
    version|--version) shift; cmd_version "$@" ;;
    status)    shift; cmd_status "$@" ;;
    doctor)    shift; cmd_doctor "$@" ;;
    logs)      shift; cmd_logs "$@" ;;
    record)    shift; cmd_record "$@" ;;
    dictate)   shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" "$SCRIPT_DIR/dictate.py" "$@" ;;
    repair-permissions|repair_permissions) shift; cmd_repair_permissions "$@" ;;
    transcription|transcribe) shift; cmd_transcription "$@" ;;
    vocab)     shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m vocab.cli "$@" ;;
    provision) shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m provision.cli provision "$@" ;;
    skill)     shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m provision.cli skill "$@" ;;
    mcp)       shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m provision.cli mcp "$@" ;;
    migrate)
        shift
        if [[ "${1:-}" == "unify-voicemails" ]]; then
            shift
            PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m migrate.voicemail_unify "$@"
        else
            PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m migrate.cli migrate "$@"
        fi
        ;;
    rollback)  shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m migrate.cli rollback "$@" ;;
    stt)       shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m stt_cli "$@" ;;
    prompts)   shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m prompts.cli "$@" ;;
    summaries) shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m summaries_cli "$@" ;;
    memo)      err "'yulu memo' was removed — all recordings are meetings now. Use: yulu record start \"<title>\""; exit 1 ;;
    search)    shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m search.cli "$@" ;;
    status-agent|statusagent) shift; PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}" exec "${PYTHON:-python3}" -m status_agent_config "$@" ;;
    where)     shift; cmd_where "$@" ;;
    help|-h|--help) usage ;;
    *)         err "Unknown command: $1"; echo; usage; exit 1 ;;
esac
