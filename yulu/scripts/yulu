#!/usr/bin/env bash
#
# yulu — single-entry CLI for the Yulu meeting recorder.
#
# This script is what gets symlinked to ~/.local/bin/yulu by setup.sh.
# It dispatches to the underlying scripts in the repo so the user has
# one stable command surface even if the repo path changes.
#
# Subcommands:
#   yulu setup                Run the interactive installer (fresh install)
#   yulu update               git pull + setup.sh --upgrade
#   yulu uninstall            Remove launchd, Yulu.app, agent skills, ~/.config/yulu
#   yulu start                Load all yulu LaunchAgents
#   yulu stop                 Unload all yulu LaunchAgents
#   yulu restart              stop + start
#   yulu status               Show service + daemon health
#   yulu logs [name]          Tail logs (default: audio_daemon)
#   yulu record start "title" Manual recording start
#   yulu record stop          Manual recording stop
#   yulu where                Print key paths (repo / config / recordings / launchagents)

set -e

# Resolve the repo root from this script's actual location (follows symlinks).
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"

CONFIG_DIR="$HOME/.config/yulu"
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

ok()   { printf "${GREEN}✓${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}⚠${NC} %s\n" "$1"; }
err()  { printf "${RED}✗${NC} %s\n" "$1"; }
info() { printf "${BLUE}ℹ${NC} %s\n" "$1"; }

usage() {
    cat <<EOF
yulu — meeting recorder CLI

Usage: yulu <command> [args]

Commands:
  setup            Run the interactive installer (fresh install)
  update           Pull latest code and re-run setup in upgrade mode
  uninstall        Remove Yulu from this machine
  start            Load all Yulu LaunchAgents
  stop             Unload all Yulu LaunchAgents
  restart          stop + start
  status           Service + daemon health snapshot
  logs [daemon]    Tail logs. Daemon = audio_daemon (default), scheduler, detector, calendar, realtime_transcribe
  record start "title"   Manually start a recording
  record stop            Manually stop the current recording
  where            Print key paths
  help             Show this help

Project: https://github.com/Nowhitestar/Yulu
EOF
}

# ─── Subcommands ──────────────────────────────────────────────────

cmd_setup() {
    bash "$SCRIPT_DIR/setup.sh" "$@"
}

cmd_update() {
    info "Updating Yulu"
    cd "$REPO_DIR"
    if ! git -C "$REPO_DIR" rev-parse --git-dir &>/dev/null; then
        err "$REPO_DIR is not a git checkout — can't auto-update."
        echo "  Reinstall manually:"
        echo "    rm -rf $REPO_DIR && curl -fsSL https://raw.githubusercontent.com/Nowhitestar/Yulu/main/install.sh | bash"
        exit 1
    fi

    local before_sha
    before_sha=$(git -C "$REPO_DIR" rev-parse HEAD)
    git -C "$REPO_DIR" fetch --quiet origin
    if ! git -C "$REPO_DIR" pull --ff-only origin main; then
        err "git pull failed (uncommitted changes?). Resolve manually in $REPO_DIR."
        exit 1
    fi
    local after_sha
    after_sha=$(git -C "$REPO_DIR" rev-parse HEAD)

    if [[ "$before_sha" == "$after_sha" ]]; then
        ok "Already up to date ($after_sha)"
        echo
        info "Re-running setup --upgrade anyway in case any host-side state needs refreshing."
    else
        ok "Pulled $before_sha → $after_sha"
    fi

    echo
    bash "$SCRIPT_DIR/setup.sh" --upgrade
}

cmd_uninstall() {
    if [[ -x "$SCRIPT_DIR/uninstall.sh" ]]; then
        bash "$SCRIPT_DIR/uninstall.sh" "$@"
    else
        err "uninstall.sh not found at $SCRIPT_DIR — your install may be partial."
        exit 1
    fi
}

# Iterate over all yulu LaunchAgent plists.
each_plist() {
    local cb="$1"
    local found=0
    for plist in "$LAUNCH_AGENTS_DIR"/com.yulu.*.plist; do
        [[ -f "$plist" ]] || continue
        found=1
        "$cb" "$plist"
    done
    if [[ $found -eq 0 ]]; then
        warn "No yulu LaunchAgents installed at $LAUNCH_AGENTS_DIR/com.yulu.*.plist"
        warn "Run: yulu setup"
        return 1
    fi
}

_load_one()   { launchctl load   "$1" 2>/dev/null && ok "loaded $(basename "$1")"   || warn "could not load $(basename "$1")"; }
_unload_one() { launchctl unload "$1" 2>/dev/null && ok "unloaded $(basename "$1")" || warn "could not unload $(basename "$1")"; }

cmd_start() {
    info "Loading Yulu LaunchAgents"
    each_plist _load_one
}

cmd_stop() {
    info "Unloading Yulu LaunchAgents"
    each_plist _unload_one
}

cmd_restart() {
    cmd_stop || true
    sleep 1
    cmd_start
}

cmd_status() {
    info "LaunchAgents:"
    if launchctl list | grep com.yulu; then
        :
    else
        warn "No com.yulu.* services running"
    fi
    echo
    info "audio_daemon socket:"
    if [[ -S "$CONFIG_DIR/audio_daemon.sock" ]]; then
        local resp
        resp=$(echo '{"action":"status"}' | nc -w 2 -U "$CONFIG_DIR/audio_daemon.sock" 2>/dev/null || true)
        if [[ -n "$resp" ]]; then
            echo "$resp" | python3 -m json.tool 2>/dev/null || echo "$resp"
        else
            warn "socket exists but no response"
        fi
    else
        warn "socket not found at $CONFIG_DIR/audio_daemon.sock"
    fi
    echo
    info "Recent recordings:"
    local rec_dir
    rec_dir=$(python3 -c "
import json
from pathlib import Path
try:
    cfg = json.loads(Path.home().joinpath('.config/yulu/config.json').read_text())
    print(cfg.get('audio', {}).get('output_dir', ''))
except Exception:
    pass
" 2>/dev/null)
    rec_dir="${rec_dir/#\~/$HOME}"
    if [[ -n "$rec_dir" && -d "$rec_dir" ]]; then
        echo "  $rec_dir"
        ls -lt "$rec_dir"/*.wav 2>/dev/null | head -5 | awk '{print "    "$NF" ("$5" bytes)"}'
    else
        warn "recording directory not configured or missing"
    fi
}

cmd_logs() {
    local name="${1:-audio_daemon}"
    local log_path="$CONFIG_DIR/${name}.log"
    if [[ ! -f "$log_path" ]]; then
        # Try alternative paths used by some daemons.
        local alt="$HOME/Library/Logs/yulu/${name}.log"
        if [[ -f "$alt" ]]; then
            log_path="$alt"
        else
            err "No log file at $log_path or $alt"
            echo "Available logs:"
            ls "$CONFIG_DIR"/*.log 2>/dev/null
            ls "$HOME/Library/Logs/yulu"/*.log 2>/dev/null
            exit 1
        fi
    fi
    info "tail -f $log_path  (Ctrl-C to stop)"
    tail -f "$log_path"
}

cmd_record() {
    local action="${1:-}"
    case "$action" in
        start)
            local title="${2:-}"
            if [[ -z "$title" ]]; then
                err "Usage: yulu record start \"<meeting title>\""
                exit 1
            fi
            python3 "$SCRIPT_DIR/record_audio.py" start "$title"
            ;;
        stop)
            python3 "$SCRIPT_DIR/record_audio.py" stop
            ;;
        status)
            python3 "$SCRIPT_DIR/record_audio.py" status
            ;;
        *)
            err "Usage: yulu record {start|stop|status}"
            exit 1
            ;;
    esac
}

cmd_where() {
    echo "Repo (code):       $REPO_DIR"
    echo "Config:            $CONFIG_DIR"
    echo "LaunchAgents:      $LAUNCH_AGENTS_DIR/com.yulu.*.plist"
    echo "Whisper models:    $CONFIG_DIR/models/"
    local rec_dir
    rec_dir=$(python3 -c "
import json
from pathlib import Path
try:
    cfg = json.loads(Path.home().joinpath('.config/yulu/config.json').read_text())
    print(cfg.get('audio', {}).get('output_dir', '<unset>'))
except Exception:
    print('<config not readable>')
" 2>/dev/null)
    echo "Recordings:        $rec_dir"
    echo "Yulu.app:          $REPO_DIR/yulu/scripts/Yulu.app"
}

# ─── Dispatcher ───────────────────────────────────────────────────

case "${1:-help}" in
    setup)     shift; cmd_setup "$@" ;;
    update)    shift; cmd_update "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    start)     shift; cmd_start "$@" ;;
    stop)      shift; cmd_stop "$@" ;;
    restart)   shift; cmd_restart "$@" ;;
    status)    shift; cmd_status "$@" ;;
    logs)      shift; cmd_logs "$@" ;;
    record)    shift; cmd_record "$@" ;;
    where)     shift; cmd_where "$@" ;;
    help|-h|--help) usage ;;
    *)         err "Unknown command: $1"; echo; usage; exit 1 ;;
esac
